#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
if [[ ${1:-} == --help ]]; then
    echo 'Usage: ./bm-web [performance-profile options]'
    echo 'Measures both optimized WASM implementations in Chromium, with 1 and 12 CPU affinity cases.'
    exit 0
fi
tools=$(nix build --no-link --print-out-paths .#wasm-benchmark)
profiler=$(nix build --no-link --print-out-paths .#profiling-tool)
export PATH="$tools/bin:$PATH"
export PERFORMANCE_HISTORY_URL="${PERFORMANCE_HISTORY_URL:-file://${XDG_STATE_HOME:-$HOME/.local/state}/performance-history}"
exec "$profiler/bin/performance-profile" run --config profiling-web.json --mode bm "$@"
